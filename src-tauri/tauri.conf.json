{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "P-Rune",
  "mainBinaryName": "P-Rune",
  "version": "0.2.0",
  "identifier": "com.debloater.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "P-Rune",
        "width": 1240,
        "height": 800,
        "minWidth": 960,
        "minHeight": 620,
        "theme": "Dark",
        "center": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'; frame-ancestors 'none'; worker-src 'none'",
      "devCsp": null,
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "buccellaluciano",
    "copyright": "Copyright © 2026 buccellaluciano",
    "homepage": "https://github.com/buccellaluciano/debloater",
    "category": "Utility",
    "shortDescription": "Debloater y ajustes para Windows 11",
    "longDescription": "Quita apps preinstaladas, aplica ajustes de privacidad y rendimiento con vista previa y deshacer, instala programas con winget y analiza el uso del disco.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./installer-hooks.nsh",
        "installerIcon": "icons/icon.ico"
      },
      "wix": {
        "language": "es-ES",
        "upgradeCode": "d27e5eea-24b4-4049-adb9-ed303f693a5d"
      }
    }
  }
}
